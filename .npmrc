# React Native / Expo autolinking and Metro's config loader assume a flat,
# hoisted node_modules (they resolve packages like `expo-asset` via Node's
# ordinary lookup, not Metro's resolver). pnpm's default isolated store hides
# those transitive deps, so we opt this workspace into a hoisted layout — the
# approach Expo documents for pnpm monorepos.
node-linker=hoisted
