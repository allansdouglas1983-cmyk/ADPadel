{
  "name": "marque-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Marque — offline-first padel scorekeeping. Sport-agnostic scoring core, padel-first launch.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
