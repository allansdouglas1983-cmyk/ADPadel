# Copy to .env.local and fill in. NEVER commit real values — these are injected
# via EAS build secrets. Free users never need Supabase/RevenueCat configured.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_RC_IOS=
EXPO_PUBLIC_RC_ANDROID=
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (NOT bundled at runtime). Used by the release build to upload
# Sentry source maps; leave empty for sideload/dev builds. The APK workflow sets
# SENTRY_DISABLE_AUTO_UPLOAD=true so the upload is skipped when these are absent.
SENTRY_AUTH_TOKEN=
