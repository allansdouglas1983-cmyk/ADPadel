{
  "name": "@padel/scoring-engine",
  "version": "0.1.0",
  "description": "Pure, deterministic, framework-free scoring engine. Rules are data, not code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/padel.d.ts",
      "default": "./dist/presets/padel.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "esbuild src/global.ts --bundle --format=iife --global-name=MarqueBundle --target=es2018 --outfile=dist/marque-engine.global.js",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.24.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
